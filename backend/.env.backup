# LocoFinder Backend Environment Variables
# Copy this file to .env and fill in your actual values

# ===================================
# REQUIRED - Google Maps API
# ===================================
# Get your key from: https://console.cloud.google.com/
# 1. Create a project
# 2. Enable "Places API (New)"
# 3. Set up billing (required for Places API)
# 4. Create API key
GOOGLE_MAPS_API_KEY=

# ===================================
# OPTIONAL - Census API
# ===================================
# Get free key from: https://api.census.gov/data/key_signup.html
# Works without key but with lower rate limits (500 requests/day)
CENSUS_API_KEY=

# ===================================
# CACHE - Redis
# ===================================
# Redis connection URL
# Default: redis://localhost:6379
# Production: redis://username:password@host:port
REDIS_URL=redis://localhost:6379

# ===================================
# DATABASE - DuckDB
# ===================================
# Path to DuckDB database file
# Default: backend/data/locations.db
DATABASE_URL=backend/data/locations.db

# ===================================
# APPLICATION SETTINGS
# ===================================
# Application environment (development, staging, production)
ENVIRONMENT=development

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ===================================
# API SETTINGS (Optional)
# ===================================
# Google Places API settings
PLACES_API_TIMEOUT=30
PLACES_API_MAX_RESULTS=20

# Census API settings
CENSUS_API_TIMEOUT=60
CENSUS_API_YEAR=2023

# ===================================
# SECURITY (Production)
# ===================================
# Secret key for sessions/tokens (generate with: openssl rand -hex 32)
# SECRET_KEY=

# Allowed CORS origins (comma-separated)
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ===================================
# NOTES
# ===================================
# - Never commit this file with actual values to git
# - Keep .env in your .gitignore
# - Use different keys for development and production
# - Set up billing alerts for Google APIs
# - Rotate keys periodically for security
GOOGLE_MAPS_API_KEY=AIzaSyDe6VwdxmqbLKPrbcdla10_1rAgE8QrtP4
